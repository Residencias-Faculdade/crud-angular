# COMPATIBILIDADE COM ATIVIDADENGX - .env.example
# ARQUIVO NOVO (antes nao existia, .env era ignorado sem exemplo).
# Replica atividadengx/.env.example para rodar na mesma rede/app-network.
# FRONTEND_PORT deve ser igual a POSTS_CRUD_PORT da shell (4200).
# Demais vars devem casar com keycloak/realm.json e environments.
FRONTEND_PORT=4200 # host -> container :80, shell busca http://localhost:4200/main.js
KEYCLOAK_PORT=8080 # deve ser igual SHELL KEYCLOAK_PORT para nao conflitar
KEYCLOAK_URL=http://localhost:8080 # usado por environments e KeycloakService
KEYCLOAK_REALM=atividadengx # realm importado em keycloak/realm.json:2
KEYCLOAK_CLIENT_ID=frontend # client publicClient PKCE S256
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
